# Copy to .env and adjust. Never commit .env.
# All settings are documented in docs/DEPLOYMENT.md.

SABOSS_ENV=production
# Public address of the app (used in e-mails, alert links and the CSRF origin check)
SABOSS_BASE_URL=https://scan.example.com
# Comma-separated host names the app answers to
SABOSS_ALLOWED_HOSTS=scan.example.com
# Secure cookies require HTTPS. Only set to false for local HTTP testing.
SABOSS_COOKIE_SECURE=true
SABOSS_REGISTRATION_OPEN=true
SABOSS_LOG_LEVEL=INFO

# Used by docker-compose.yml for the PostgreSQL container. Choose a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Scanning
SABOSS_SCAN_WORKERS=2
SABOSS_SCANS_PER_ORG_PER_HOUR=30
SABOSS_SCHEDULER_ENABLED=true

# Optional e-mail (password resets and alerts). Leave SABOSS_SMTP_HOST empty to disable.
SABOSS_SMTP_HOST=
SABOSS_SMTP_PORT=587
SABOSS_SMTP_USER=
SABOSS_SMTP_PASSWORD=
SABOSS_SMTP_FROM=
SABOSS_SMTP_STARTTLS=true

# Reverse proxy addresses whose X-Forwarded-* headers are trusted
SABOSS_FORWARDED_ALLOW_IPS=127.0.0.1
